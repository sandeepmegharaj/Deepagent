# Required by the default model, openai:gpt-5.
OPENAI_API_KEY=your_openai_api_key_here

# Required for the repository's internet-search tool. The rest of the agent
# works without it, but research requests will not be able to search the web.
TAVILY_API_KEY=your_tavily_api_key_here

# Optional if you add a model option for these providers.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
